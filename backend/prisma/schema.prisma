generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ CUSTOMER MANAGEMENT ============

model Customer {
  id                String            @id @default(uuid())
  email             String            @unique
  phone             String?
  firstName         String
  lastName          String
  passwordHash      String
  starchPreference  StarchLevel       @default(MEDIUM)
  hangerPreference  Boolean           @default(true)
  creasePreference  Boolean           @default(false)
  notes             String?
  creditBalance     Decimal           @default(0) @db.Decimal(10, 2)
  loyaltyPoints     Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  addresses         Address[]
  paymentMethods    PaymentMethod[]
  orders            Order[]
  subscriptions     Subscription[]
  giftCards         GiftCard[]
  notifications     Notification[]
  qualityIssues     QualityIssue[]
}

enum StarchLevel {
  NONE
  LIGHT
  MEDIUM
  HEAVY
}

model Address {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String    // "Home", "Work", etc.
  street        String
  apartment     String?
  city          String
  state         String
  zipCode       String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean   @default(false)
  instructions  String?
  createdAt     DateTime  @default(now())

  pickups       Pickup[]
  deliveries    Delivery[]
}

model PaymentMethod {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            PaymentType
  lastFour        String?
  expiryMonth     Int?
  expiryYear      Int?
  stripePaymentId String?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  payments        Payment[]
}

enum PaymentType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  GIFT_CARD
  CREDIT_BALANCE
  CHECK
}

// ============ ORDER MANAGEMENT ============

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  status            OrderStatus   @default(PENDING)
  isRush            Boolean       @default(false)
  rushFee           Decimal       @default(0) @db.Decimal(10, 2)
  specialInstructions String?
  subtotal          Decimal       @default(0) @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  tax               Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(10, 2)
  estimatedReady    DateTime?
  actualReady       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             OrderItem[]
  pickup            Pickup?
  delivery          Delivery?
  payments          Payment[]
  notifications     Notification[]
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  qualityIssues     QualityIssue[]
  trackingHistory   OrderTracking[]
}

enum OrderStatus {
  PENDING
  PICKED_UP
  PROCESSING
  CLEANING
  PRESSING
  QUALITY_CHECK
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  garmentTypeId   String
  garmentType     GarmentType   @relation(fields: [garmentTypeId], references: [id])
  quantity        Int           @default(1)
  tagNumber       String?
  barcode         String?
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  specialNotes    String?
  stainNotes      String?
  status          ItemStatus    @default(PENDING)
  createdAt       DateTime      @default(now())

  alterations     Alteration[]
}

enum ItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ISSUE
}

model GarmentType {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String      // "Tops", "Bottoms", "Outerwear", etc.
  basePrice   Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)

  orderItems  OrderItem[]
  servicePrices ServicePrice[]
}

model Service {
  id            String          @id @default(uuid())
  name          String          @unique
  description   String?
  category      ServiceCategory
  basePrice     Decimal         @db.Decimal(10, 2)
  estimatedDays Int             @default(2)
  isActive      Boolean         @default(true)

  orderItems    OrderItem[]
  servicePrices ServicePrice[]
}

enum ServiceCategory {
  DRY_CLEANING
  LAUNDRY
  WASH_FOLD
  PRESSING
  ALTERATIONS
  SPECIALTY
}

// ============ PICKUP & DELIVERY ============

model Driver {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String
  firstName     String
  lastName      String
  passwordHash  String
  licenseNumber String?
  vehicleInfo   String?
  isActive      Boolean   @default(true)
  isAvailable   Boolean   @default(true)
  currentLat    Float?
  currentLng    Float?
  createdAt     DateTime  @default(now())

  routes        Route[]
  pickups       Pickup[]
  deliveries    Delivery[]
  locationHistory DriverLocation[]
}

model Route {
  id            String        @id @default(uuid())
  driverId      String
  driver        Driver        @relation(fields: [driverId], references: [id])
  date          DateTime
  status        RouteStatus   @default(PLANNED)
  startTime     DateTime?
  endTime       DateTime?
  totalDistance Float?
  totalStops    Int           @default(0)
  optimizedOrder String?      // JSON array of stop order
  createdAt     DateTime      @default(now())

  pickups       Pickup[]
  deliveries    Delivery[]
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Pickup {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  addressId       String
  address         Address       @relation(fields: [addressId], references: [id])
  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id])
  routeId         String?
  route           Route?        @relation(fields: [routeId], references: [id])
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualTime      DateTime?
  status          PickupStatus  @default(SCHEDULED)
  notes           String?
  photoUrl        String?
  signature       String?
  createdAt       DateTime      @default(now())
}

enum PickupStatus {
  SCHEDULED
  EN_ROUTE
  ARRIVED
  COMPLETED
  FAILED
  CANCELLED
}

model Delivery {
  id              String          @id @default(uuid())
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id])
  addressId       String
  address         Address         @relation(fields: [addressId], references: [id])
  driverId        String?
  driver          Driver?         @relation(fields: [driverId], references: [id])
  routeId         String?
  route           Route?          @relation(fields: [routeId], references: [id])
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualTime      DateTime?
  status          DeliveryStatus  @default(SCHEDULED)
  notes           String?
  photoUrl        String?
  signature       String?
  lockerId        String?
  locker          Locker?         @relation(fields: [lockerId], references: [id])
  createdAt       DateTime        @default(now())
}

enum DeliveryStatus {
  SCHEDULED
  EN_ROUTE
  ARRIVED
  DELIVERED
  IN_LOCKER
  FAILED
  CANCELLED
}

model Locker {
  id          String      @id @default(uuid())
  name        String
  location    String
  address     String
  totalUnits  Int
  availableUnits Int
  isActive    Boolean     @default(true)

  deliveries  Delivery[]
}

// ============ PRICING ============

model ServicePrice {
  id            String      @id @default(uuid())
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  garmentTypeId String
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)
  price         Decimal     @db.Decimal(10, 2)

  @@unique([serviceId, garmentTypeId])
}

model Alteration {
  id            String      @id @default(uuid())
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  typeId        String
  type          AlterationType @relation(fields: [typeId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  notes         String?
  status        ItemStatus  @default(PENDING)
}

model AlterationType {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  basePrice   Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)

  alterations Alteration[]
}

model Subscription {
  id              String            @id @default(uuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  planId          String
  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  renewalDate     DateTime
  stripeSubId     String?
  createdAt       DateTime          @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  billingCycle    BillingCycle
  itemLimit       Int?
  discountPercent Int             @default(0)
  freePickups     Int             @default(0)
  freeDeliveries  Int             @default(0)
  isActive        Boolean         @default(true)

  subscriptions   Subscription[]
}

enum BillingCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal       @db.Decimal(10, 2)
  minOrderAmount  Decimal?      @db.Decimal(10, 2)
  maxDiscount     Decimal?      @db.Decimal(10, 2)
  usageLimit      Int?
  usageCount      Int           @default(0)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean       @default(true)

  orders          Order[]
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model GiftCard {
  id          String    @id @default(uuid())
  code        String    @unique
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  balance     Decimal   @db.Decimal(10, 2)
  initialValue Decimal  @db.Decimal(10, 2)
  expiryDate  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ============ MACHINE MANAGEMENT ============

model Machine {
  id              String          @id @default(uuid())
  machineNumber   String          @unique
  type            MachineType
  brand           String?
  model           String?
  capacity        String?
  status          MachineStatus   @default(AVAILABLE)
  currentCycleEnd DateTime?
  pricePerCycle   Decimal         @db.Decimal(10, 2)
  locationId      String
  location        Location        @relation(fields: [locationId], references: [id])
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  totalCycles     Int             @default(0)
  isRemoteEnabled Boolean         @default(false)
  iotDeviceId     String?
  createdAt       DateTime        @default(now())

  usages          MachineUsage[]
  maintenances    Maintenance[]
}

enum MachineType {
  WASHER
  DRYER
  COMBO
  PRESS
  FOLDER
}

enum MachineStatus {
  AVAILABLE
  IN_USE
  OUT_OF_ORDER
  MAINTENANCE
  RESERVED
}

model Location {
  id          String    @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  isActive    Boolean   @default(true)
  openTime    String?
  closeTime   String?

  machines    Machine[]
  staff       Staff[]
}

model MachineUsage {
  id            String    @id @default(uuid())
  machineId     String
  machine       Machine   @relation(fields: [machineId], references: [id])
  customerId    String?
  startTime     DateTime
  endTime       DateTime?
  cycleType     String?
  amountPaid    Decimal   @db.Decimal(10, 2)
  paymentMethod String?
  status        UsageStatus @default(IN_PROGRESS)
}

enum UsageStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Maintenance {
  id            String            @id @default(uuid())
  machineId     String
  machine       Machine           @relation(fields: [machineId], references: [id])
  type          MaintenanceType
  description   String?
  scheduledDate DateTime
  completedDate DateTime?
  cost          Decimal?          @db.Decimal(10, 2)
  technicianName String?
  notes         String?
  status        MaintenanceStatus @default(SCHEDULED)
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
  CLEANING
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============ POINT OF SALE ============

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  reference       String?
  createdAt       DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Receipt {
  id          String    @id @default(uuid())
  orderId     String
  receiptNumber String  @unique
  amount      Decimal   @db.Decimal(10, 2)
  printedAt   DateTime?
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ============ STAFF & AUTH ============

model Staff {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?
  firstName     String
  lastName      String
  passwordHash  String
  role          StaffRole
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id])
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
}

enum StaffRole {
  ADMIN
  MANAGER
  CLERK
  PRESSER
  CLEANER
}

// ============ NOTIFICATIONS ============

model Notification {
  id          String            @id @default(uuid())
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id])
  type        NotificationType
  channel     NotificationChannel
  subject     String?
  message     String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime          @default(now())
}

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_READY
  ORDER_DELIVERED
  PICKUP_REMINDER
  DELIVERY_UPDATE
  PROMOTION
  REACTIVATION
  CYCLE_COMPLETE
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============ AI FEATURES ============

model AIEstimate {
  id            String    @id @default(uuid())
  customerId    String?
  imageUrl      String?
  description   String?
  estimatedItems Json?
  totalEstimate Decimal?  @db.Decimal(10, 2)
  confidence    Float?
  createdAt     DateTime  @default(now())
}

model AIStainAnalysis {
  id              String    @id @default(uuid())
  orderItemId     String?
  imageUrl        String?
  stainType       String?
  treatment       String?
  confidence      Float?
  createdAt       DateTime  @default(now())
}

model AIChatHistory {
  id          String    @id @default(uuid())
  customerId  String?
  sessionId   String
  role        String
  message     String
  createdAt   DateTime  @default(now())
}

model AIDemandPrediction {
  id              String    @id @default(uuid())
  locationId      String?
  date            DateTime
  predictedOrders Int
  predictedRevenue Decimal? @db.Decimal(10, 2)
  confidence      Float?
  createdAt       DateTime  @default(now())
}

// ============ QUALITY ISSUE REPORTING ============

model QualityIssue {
  id              String            @id @default(uuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  orderItemId     String?
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  reportedBy      String?           // Staff ID who reported
  issueType       QualityIssueType
  severity        IssueSeverity     @default(MEDIUM)
  status          IssueStatus       @default(OPEN)
  title           String
  description     String
  photoUrls       String[]          @default([])
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  compensationType CompensationType?
  compensationAmount Decimal?       @db.Decimal(10, 2)
  customerNotified Boolean          @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum QualityIssueType {
  DAMAGE
  STAIN_NOT_REMOVED
  WRONG_ITEM
  MISSING_ITEM
  SHRINKAGE
  COLOR_BLEEDING
  PRESSING_ISSUE
  ODOR
  LOST_BUTTON
  TORN_FABRIC
  OTHER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum CompensationType {
  REFUND
  CREDIT
  REDO_SERVICE
  DISCOUNT
  REPLACEMENT
  NONE
}

// ============ REAL-TIME TRACKING ============

model DriverLocation {
  id          String    @id @default(uuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  latitude    Float
  longitude   Float
  heading     Float?
  speed       Float?
  accuracy    Float?
  batteryLevel Int?
  isOnline    Boolean   @default(true)
  timestamp   DateTime  @default(now())
}

model OrderTracking {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  status      String
  location    String?
  note        String?
  latitude    Float?
  longitude   Float?
  timestamp   DateTime  @default(now())
}
